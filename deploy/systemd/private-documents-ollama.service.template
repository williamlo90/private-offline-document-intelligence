[Unit]
Description=Project 07 local Ollama (offline)
After=local-fs.target
ConditionPathExists=@ROOT@/runtime/bin/ollama

[Service]
Type=simple
User=project07
Group=project07
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_NO_CLOUD=1
Environment=OLLAMA_MODELS=@ROOT@/releases/@RELEASE@/local/models/ollama
ExecStart=@ROOT@/runtime/bin/ollama serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@ROOT@/state
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=6G

[Install]
WantedBy=multi-user.target
