      "family": "identity-access",
      "kind": "contract",
      "language": "eng",
      "effective": "2026-05-01",
      "expires": "2027-04-30",
      "file": "atlas-identity-annex.pdf",
      "sha256": "fd325bcec9162bf36d05f4f39bcfd2b4e0f20c409d72eced66705dff401a0472",
      "pages": [
        {
          "number": 1,
          "method": "text",
          "quality": "usable",
          "text": "PRIVATE LAB / ATLAS / CONTRACT\nPrivileged identity oversight\n01\nManaged identity access reviews cover one quarterly audit of privileged accounts.\n02\nNew account provisioning is excluded from the review service.\n03\nFor critical access lockouts, the initial acknowledgement target is 50 minutes during staffed weekdays.\n"
        }
      ]
    },
    {
