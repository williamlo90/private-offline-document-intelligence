      "sha256": "731dc49d9f503df51c76c60bbfda0bc74fd21c235fdf3ca0ae8f5f3a03255136",
      "pages": [
        {
          "number": 1,
          "method": "text",
          "quality": "usable",
          "text": "PRIVATE LAB / ATLAS / SOP\nEndpoint isolation desk procedure\n01\nRecord the affected endpoint asset tag.\n02\nCapture the isolation alert ID in the local ticket.\n03\nAsk the security lead to approve reconnect scheduling.\n04\nDo not reconnect the endpoint automatically.\n"
        }
      ]
    },
