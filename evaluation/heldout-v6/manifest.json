        {
          "number": 1,
          "method": "text",
          "quality": "usable",
          "text": "Endpoint signature freshness\nATLAS / CONTRACT / synthetic local source\nAtlas EDR freshness review covers two daily signature checks of managed\nendpoint agents.\nEndpoint license renewal purchases are excluded from this review.\nFor an urgent stale-signature alert, the initial acknowledgement target\nis 38 minutes during the operations window.\n"
        }
      ]
    },
