      "sha256": "500e6c18f6c3b1011e3f27e3f98ec1f6c21276df011ee63e1cdee3e2136b41aa",
      "pages": [
        {
          "number": 1,
          "method": "text",
          "quality": "usable",
          "text": "ATLAS | CONTRACT | Gateway clock drift schedule\n1.\nAtlas managed clock review covers one weekly drift check of gateway time\nsources.\n2.\nPhysical GPS antenna procurement is excluded from the clock review.\n3.\nA critical clock drift alert has an initial acknowledgement target of 52\nminutes within office hours.\n"
        }
      ]
    },
