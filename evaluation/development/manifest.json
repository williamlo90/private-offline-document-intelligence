      "sha256": "eff55f1ad343cd996613b11fb81bac52f5a567a2156cd823c2c11d85159f1766",
      "pages": [
        {
          "number": 1,
          "section": "Pemeriksaan disk",
          "text": "Langkah 1: Buka dashboard server lokal. Langkah 2: Catat persentase ruang disk kosong. Langkah 3: Jika ruang kosong kurang dari 15 persen, eskalasi ke service manager. Jangan hapus file otomatis."
        }
      ]
    },
