      "sha256": "8eca20c622fc3a7e18c31ea103070b147f2753d7b68db3e139ed9b887fbb8a45",
      "pages": [
        {
          "number": 1,
          "section": "Coverage",
          "text": "Birch service covers managed server monitoring every day, 00:00 to 24:00 WIB. Application development is excluded."
        },
        {
          "number": 2,
          "section": "Response",
          "text": "For critical incidents, the initial response target is 20 minutes. This is not a resolution guarantee."
        }
      ]
    },
