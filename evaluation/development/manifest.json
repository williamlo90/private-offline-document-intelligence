    {
      "id": "atlas-sla-v1",
      "tenant": "atlas",
      "family": "atlas-sla",
      "kind": "contract",
      "effective": "2026-01-01",
      "expires": "2026-12-31",
      "file": "atlas-sla-v1.pdf",
      "sha256": "731c790ba55cd1c4e17e1022ff18cfe094a7f5414f815e65e372adc3cff330ec",
      "pages": [
        {
          "number": 1,
          "section": "Coverage",
          "text": "Atlas service covers managed laptop support Monday to Friday, 09:00 to 17:00 WIB. Hardware replacement purchases are excluded."
        },
        {
          "number": 2,
          "section": "Response",
          "text": "For critical incidents, the initial response target is 60 minutes during service hours. This is not a resolution guarantee."
        }
      ]
    },
    {
      "id": "atlas-backup-v1",
      "tenant": "atlas",
      "family": "atlas-backup",
      "kind": "SOP",
      "effective": "2026-01-01",
      "expires": "2026-12-31",
      "file": "atlas-backup-v1.pdf",
      "sha256": "c07f2daa19c1e0e03dd51e3c2151869aeba39a6a13d2f052119a95431c004443",
      "pages": [
        {
          "number": 1,
          "section": "Backup verification",
          "text": "Step 1: Open the local backup console. Step 2: Check the most recent backup result. Step 3: Record the job ID and completion time. Step 4: Escalate failed jobs to the service manager. Do not restore production data during verification."
        }
      ]
    },
    {
      "id": "atlas-vpn-v1",
      "tenant": "atlas",
      "family": "atlas-vpn",
      "kind": "runbook",
      "effective": "2026-01-01",
      "expires": "2026-12-31",
      "file": "atlas-vpn-v1.pdf",
      "sha256": "48281621708af41fa018bed68695da95d971857935dd25292b67c354dbb85b7e",
      "pages": [
        {
          "number": 1,
          "section": "VPN diagnostics",
          "text": "Record the VPN error code. Check the approved gateway status. Escalate persistent connection failures to the network team. Never request a user password."
        }
      ]
    },
    {
      "id": "birch-sla-v1",
      "tenant": "birch",
