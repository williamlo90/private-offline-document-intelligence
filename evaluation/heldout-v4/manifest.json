      "file": "atlas-badge-annex.pdf",
      "sha256": "36fc229ab0f6fb8b5679021504201e9ab08987f123d2333cf206f90498435f2f",
      "pages": [
        {
          "number": 1,
          "method": "text",
          "quality": "usable",
          "text": "Badge access review\nClient: atlas   Document: contract   Leaf: 1\nAtlas badge access review covers three access-list checks each month.\nPhysical badge fabrication is excluded from this service.\nAn urgent lost-badge request has an initial acknowledgement target of 70\nminutes during staffed hours.\n"
        }
      ]
    },
    {
      "id": "atlas-router-release",
      "tenant": "atlas",
      "family": "router-release",
      "kind": "SOP",
      "language": "eng",
      "effective": "2026-03-01",
      "expires": "2027-03-01",
      "file": "atlas-router-release.pdf",
      "sha256": "b1d1e1ea187ed22288da667be15edefe6db5a24f484517564c65249c412bb871",
      "pages": [
        {
          "number": 1,
          "method": "text",
          "quality": "usable",
          "text": "Staged router release\nClient: atlas   Document: SOP   Leaf: 1\nRecord the router model and current firmware revision.\nCheck the approved maintenance window in the local schedule.\nContact the network lead if rollback is required.\nNever flash firmware outside the approved window.\n"
        }
      ]
    },
    {
